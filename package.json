{
  "name": "foundry-v2",
  "version": "0.10.0",
  "private": true,
  "description": "Foundry v2 through Milestone 10: a calm, guided software-engineering experience over the existing production foundation",
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-name-pattern=\"^(?!three clean real)\" \"test/*.test.js\"",
    "test:certification": "node --test --test-concurrency=1 --test-name-pattern=\"^three clean real\" test/milestone-8.test.js test/milestone-9.test.js",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-name-pattern=\"^(?!three clean real)\" \"test/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  }
}
